        <mxCell id="K9H-UztsufSQonzL3Dft-3" value="[IdProceso].yml" style="verticalLabelPosition=bottom;html=1;verticalAlign=top;align=center;strokeColor=none;fillColor=#00BEF2;shape=mxgraph.azure.cloud_services_configuration_file;pointerEvents=1;aspect=fixed;" vertex="1" parent="1">
