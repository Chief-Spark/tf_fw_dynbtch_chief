        <mxCell id="K9H-UztsufSQonzL3Dft-15" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;[resultado].[ext]&lt;/h1&gt;&lt;p&gt;Nombre de archivo compuesto por:&amp;nbsp;&lt;span style=&quot;text-align: center; text-wrap-mode: nowrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;[mnemotecnico]val[idSolicitud]-[idFacturacion]-aamm.[ext]&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;text-align: center; text-wrap-mode: nowrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
