        <mxCell id="ho-kKkdn2bSP1_Ccq8JN-98" value="&lt;p style=&quot;margin: 0in 0in 0in 0.5in;&quot; align=&quot;center&quot; class=&quot;MsoNormal&quot;&gt;bcoval5456-774-2510_PP0989.PP0810OUT1.csv&lt;/p&gt;" style="verticalLabelPosition=bottom;html=1;verticalAlign=top;align=center;strokeColor=none;fillColor=#00BEF2;shape=mxgraph.azure.cloud_services_configuration_file;pointerEvents=1;aspect=fixed;" vertex="1" parent="ho-kKkdn2bSP1_Ccq8JN-97">
