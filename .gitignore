# =========================
# Lambda Dependencies (instaladas por scripts/install-lambda-deps.sh en el pipeline)
# =========================
# Las dependencias NO se commitean - se instalan automáticamente en Jenkins
# Esto asegura que siempre se usen los binarios correctos para Python 3.13 ARM64
src/**/.venv_build/
src/**/pydantic/
src/**/pydantic_core/
src/**/pydantic_settings/
src/**/yaml/
src/**/_yaml/
src/**/annotated_types/
src/**/typing_extensions.py
src/**/typing_inspection/
src/**/dotenv/
src/**/bin/dotenv.exe
src/**/__pycache__/
src/**/*.pyc
src/**/*.dist-info/
pyrightconfig.json

# =========================
# PowerShell y Shell Scripts
# =========================
# (No suelen generar archivos temporales, pero puedes agregar aquí si tus scripts lo hacen)

# =========================
# IDEs y herramientas de desarrollo
# =========================
.vscode/
.kiro/
.cursor/
.DS_Store
# PyCharm y JetBrains (ver plantilla oficial para más detalles)
idea/

# =========================
# Experian: reglas adicionales y archivos no versionables
# =========================
.scannerwork/
target/
*.classpath
*.project
.settings/
*.bak
*.orig
*.7z
*.zip

# =========================
# Lambda Layers y artefactos generados
# =========================
# Excluir directorios temporales de instalación
src/layers/*/layer/
src/layers/*/venv/
src/layers/*/__pycache__/

# INCLUIR explícitamente los archivos versionados del layer
!src/layers/*.zip
!src/layers/**/*.zip
!assets/translator/lambda-bootstrap.zip

# Python portable solo para build local del layer
.tools/

# =========================
# Notas / handoff locales (no versionables)
# =========================
HANDOFF_*.md

# Contexto local (docs, snapshots, módulos de referencia para IA / integración)
.context/

# Tests (pendiente de versionar)
tests/
